Config
├─ .Addr       string             # Addr is the listen address.    (addr)
├─ .Port       int                # listen port                    (port)
├─ .Server     Server             # Server configures the server.  (server)
│   ├─ .TLS      bool  # enable TLS       (server.tls)
│   └─ .Timeout  int   # timeout seconds  (server.timeout)
├─ .Labels     map[string]string  # labels                         (labels)
│   └─ index .Labels key  string  # value at key; range .Labels  (labels[key])
├─ .Hosts      []string           # hosts                          (hosts)
│   └─ index .Hosts i  string  # element i; range .Hosts  (hosts[i])
├─ .Timeout    opt.Option[int]    #                                (timeout)
│   └─ .Timeout.Value  int  # set only when .Timeout.IsSome  (timeout)
├─ .Upstreams  []Upstream         #                                (upstreams)
│   └─ index .Upstreams i  Upstream  # element i; range .Upstreams  (upstreams[i])
│       ├─ .Name    string  # upstream name  (upstreams[i].name)
│       └─ .Weight  int     #                (upstreams[i].weight)
├─ .Tls        opt.Option[Tls]    #                                (tls)
│   └─ .Tls.Value  Tls  # set only when .Tls.IsSome  (tls)
│       └─ .Cert  string  # certificate file  (tls.cert)
├─ .Root       *Node              #                                (root)
│   ├─ .Name      string   #   (root.name)
│   └─ .Children  []*Node  #   (root.children)
│       └─ index .Root.Children i  *Node  # element i; range .Root.Children  (root.children[i])
│           └─ Node repeats; it is expanded above
├─ .Grid       [][2]int           #                                (grid)
│   └─ index .Grid i  [2]int  # element i; range .Grid  (grid[i])
│       └─ index (index .Grid i) i2  int  # element i2; range (index .Grid i)  (grid[i][i2])
├─ .Since      time.Time          #                                (since)
├─ .Raw        []byte             #                                (raw)
├─ .Any        any                #                                (any)
├─ .Ch         chan int           #                                (Ch)
└─ .Version    int                # config version                 (version)
