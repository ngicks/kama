Holders
├─ .O   opt.Option[int]                     #                                                    (O)
│   └─ .O.Value  int                        #   set only when .O.IsSome                          (O)
├─ .U   und.Und[string]                     #                                                    (U)
│   └─ .U.Value  string                     #   set only when .U.IsDefined; null when .U.IsNull  (U)
├─ .E   elastic.Elastic[int]                #                                                    (E)
│   └─ index .E.Options i  opt.Option[int]  #   an opt.Option per element; range .E.Options      (E[i])
│       └─ (index .E.Options i).Value  int  #     set only when (index .E.Options i).IsSome      (E[i])
├─ .Ei  either.Either[int, string]          #                                                    (Ei)
│   ├─ .Ei.UnwrapLeft   int                 #   set only when .Ei.IsLeft                         (Ei.left)
│   └─ .Ei.UnwrapRight  string              #   set only when .Ei.IsRight                        (Ei.right)
├─ .Ue  either.UntaggedEither[int, string]  #                                                    (Ue)
│   ├─ .Ue.UnwrapLeft   int                 #   set only when .Ue.IsLeft                         (Ue)
│   └─ .Ue.UnwrapRight  string              #   set only when .Ue.IsRight                        (Ue)
├─ .R   either.Result[int]                  #                                                    (R)
│   ├─ .R.Value  int                        #   set only when .R.IsOk                            (R.ok)
│   └─ .R.Err    error                      #   set only when .R.IsErr                           (R.err)
├─ .T   tuple.Tuple2[int, string]           #                                                    (T)
│   ├─ .T.V1  int                           #   always set                                       (T.V1)
│   └─ .T.V2  string                        #   always set                                       (T.V2)
├─ .N   sql.Null[int]                       #                                                    (N)
│   └─ .N.V  int                            #   set only when .N.Valid                           (N)
├─ .S   sql.NullString                      #                                                    (S)
│   └─ .S.String  string                    #   set only when .S.Valid                           (S)
├─ .H   unique.Handle[string]               #                                                    (H)
│   └─ .H.Value  string                     #   set unless .H is the zero Handle                 (H)
└─ .P   *opt.Option[Inner]                  #                                                    (P)
    └─ .P.Value  Inner                      #   set only when .P.IsSome                          (P)
        └─ .X  int                          #                                                    (P.x)
