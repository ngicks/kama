Wide
├─ .Name    string                           # 名前はユーザーの表示名です。           (name)
├─ .Mark    string                           # 区切り：「全角」（括弧）               (mark)
├─ .Party   bool                             # パーティー 🎉 開始                     (party)
├─ .Family  int                              # 家族 👨‍👩‍👧 です                           (family)
├─ .Region  string                           # 地域 🇯🇵 です                           (region)
├─ .Cafe    string                           # café au lait                           (cafe)
├─ .Sun     bool                             # 晴れ ☀️ です                           (sun)
├─ .Grid    [][]string                       # 格子                                   (grid)
│   └─ index .Grid i  []string               #   element i; range .Grid               (grid[i])
│       └─ index (index .Grid i) i2  string  #     element i2; range (index .Grid i)  (grid[i][i2])
└─ .Inner   Inner                            #                                        (inner)
    ├─ .Deep   string                        #   深い階層の説明。                     (inner.deep)
    └─ .Plain  int                           #   plain text                           (inner.plain)
