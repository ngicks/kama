{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Forest",
  "type": "object",
  "required": ["trees", "chain"],
  "properties": {
    "trees": { "type": "array", "items": { "$ref": "#/$defs/Tree" } },
    "groves": { "type": "array", "items": { "$ref": "#" } },
    "list": { "$ref": "#/$defs/List" },
    "chain": { "$ref": "#/$defs/Chain" }
  },
  "$defs": {
    "Tree": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": { "type": "string" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/Tree" } }
      }
    },
    "List": {
      "type": "object",
      "required": ["value"],
      "properties": { "value": { "type": "integer" }, "next": { "$ref": "#/$defs/List" } }
    },
    "Chain": {
      "type": "object",
      "required": ["name", "link"],
      "properties": { "name": { "type": "string" }, "link": { "$ref": "#/$defs/Link" } }
    },
    "Link": {
      "type": "object",
      "required": ["label"],
      "properties": { "label": { "type": "string" }, "chain": { "$ref": "#/$defs/Chain" } }
    },
    "Ouroboros": {
      "type": "object",
      "required": ["tail"],
      "properties": { "tail": { "$ref": "#/$defs/Ouroboros" } }
    }
  }
}
