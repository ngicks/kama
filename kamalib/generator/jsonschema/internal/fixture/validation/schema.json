{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Order",
  "description": "Order exercises the validation keywords the validators check.",
  "type": "object",
  "required": ["id", "items"],
  "minProperties": 2,
  "maxProperties": 11,
  "dependentRequired": { "coupon": ["discount"] },
  "properties": {
    "id": { "type": "string", "minLength": 3, "maxLength": 8, "pattern": "^[A-Z]+[0-9]*$" },
    "count": { "type": "integer", "minimum": 1.5, "exclusiveMaximum": 100, "multipleOf": 2 },
    "ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1.0 },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/Sku" }
    },
    "labels": {
      "type": "object",
      "maxProperties": 2,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "level": { "enum": [1, 2, 3] },
    "coupon": { "type": "string" },
    "discount": { "type": "number" },
    "closed": {
      "type": "object",
      "properties": { "a": { "type": "boolean" } },
      "additionalProperties": false
    },
    "typed": {
      "type": "object",
      "properties": { "n": { "type": "integer" } },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "pick": {
      "oneOf": [
        { "type": "string", "maxLength": 2 },
        { "type": "string", "minLength": 4 }
      ]
    }
  },
  "$defs": {
    "Sku": { "type": "string", "pattern": "^[a-z]+$" }
  }
}
