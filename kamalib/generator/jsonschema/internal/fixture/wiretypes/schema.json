{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Root",
  "description": "Root holds values whose Go types cannot tell null or an integer of a number with a fraction apart.",
  "type": "object",
  "properties": {
    "grid": { "type": "array", "items": { "type": "array", "items": { "type": "integer" } } },
    "groups": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
    "maybe": { "type": "array", "items": { "type": ["integer", "null"] } },
    "matrix": { "$ref": "#/$defs/Matrix" },
    "color": { "$ref": "#/$defs/Color" },
    "raws": { "$ref": "#/$defs/Raws" },
    "either": { "type": ["integer", "string"] },
    "list": { "oneOf": [{ "type": "array", "items": { "type": "integer" } }, { "type": "string" }] }
  },
  "additionalProperties": { "type": "integer" },
  "$defs": {
    "Matrix": { "type": "array", "minItems": 1, "items": { "type": "array", "items": { "type": "number" } } },
    "Color": { "enum": ["red", "green"] },
    "Raws": { "type": "array", "minItems": 1 }
  }
}
